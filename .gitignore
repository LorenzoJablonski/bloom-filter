# Generated artifacts: datasets and the working results database stay out of git.
# Finished campaigns are frozen into results/campaigns/<name>/ and versioned
# (logs included); new runs never write there, so they cannot dirty the tree.
data/*
!data/.gitkeep
results/*
!results/.gitkeep
!results/campaigns/
!results/campaigns/**
